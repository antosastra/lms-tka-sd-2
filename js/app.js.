  return `
    <div class="max-w-2xl mx-auto bg-white p-6 rounded-2xl border space-y-3">
      <h1 class="text-lg font-bold text-purple-900">Pantauan Orang Tua: ${escapeHtml(store.anak.nama)}</h1>
      <p class="text-xs text-slate-600">Total sesi yang diselesaikan anak: <strong>${store.riwayatSesi.length} Sesi</strong></p>
      <div class="p-3.5 bg-purple-50 rounded-xl text-xs text-purple-900">
        <strong>Rekomendasi:</strong> ${escapeHtml(store.ortu.catatanRekomendasi)}
      </div>
    </div>
  `;
}

