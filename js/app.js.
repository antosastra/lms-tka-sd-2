function viewAdminKonten(store) {
  return `
    <div class="max-w-4xl mx-auto space-y-4">
      <div class="flex justify-between items-center">
        <h1 class="text-lg font-bold">Bank Soal Draf (${store.bankSoal.length} Butir)</h1>
        <button onclick="window.LMS.openAdminModal()" class="px-3 py-1.5 bg-blue-600 text-white rounded-xl text-xs font-bold">+ Tambah Soal</button>
      </div>
      <div class="bg-white rounded-2xl border overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 border-b">
            <tr><th class="p-3">ID</th><th class="p-3">Mapel</th><th class="p-3">Kompetensi</th><th class="p-3">Kunci</th><th class="p-3 text-center">Aksi</th></tr>
          </thead>
          <tbody class="divide-y">
            ${store.bankSoal.map(b => `
              <tr>
                <td class="p-3 font-mono font-bold">${b.id}</td>
                <td class="p-3">${b.mapel}</td>
                <td class="p-3">${b.kompetensi}</td>
                <td class="p-3 font-bold text-blue-600">${b.kunci}</td>
                <td class="p-3 text-center">
                  <button onclick="window.LMS.editSoal('${b.id}')" class="text-blue-600 font-bold mr-2">Edit</button>
                  <button onclick="window.LMS.hapusSoal('${b.id}')" class="text-rose-600 font-bold">Hapus</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;
}

// Inisialisasi API Global Window
window.LMS = {
  navigate,
  pilihRole(role) {
    const s = getStore();
    s.role = role;
    saveStore(s);
    if (role === "anak") navigate("#/anak/dashboard");
    else if (role === "ortu") navigate("#/ortu/dashboard");
    else navigate("#/admin");
  },
  siapkanSesi(mode) {
    const s = getStore();
    const bank = s.bankSoal;
    const mat = bank.filter(x => x.mapel === "Matematika");
    const ind = bank.filter(x => x.mapel === "Bahasa Indonesia");

    let terpilih = [];
    if (mode === "matematika") terpilih = mat.slice(0, 4);
    else if (mode === "indonesia") terpilih = ind.slice(0, 4);
    else terpilih = [...mat.slice(0, 2), ...ind.slice(0, 2)];

    s.sesiAktif = {
      mode,
      indeksAktif: 0,
      soalList: terpilih.map(q => ({
        ...q,
        isSpacedRepetition: Boolean(s.riwayatSoal[q.id]?.isScheduledSpaced)
      }))
    };
    s.jawabanSesiAktif = {};
    s.sesiSudahDisimpan = false;
    saveStore(s);
    navigate("#/anak/latihan");
  },
  pilihJawaban(id, kode) {
    const s = getStore();
    s.jawabanSesiAktif[id] = kode;
    saveStore(s);
    renderApp();
  },
  simpanIsian(id, val) {
    const s = getStore();
    s.jawabanSesiAktif[id] = val.trim();
    saveStore(s);
  },
  pindahSoal(idx) {
    const s = getStore();
    if (s.sesiAktif && idx >= 0 && idx < s.sesiAktif.soalList.length) {
      s.sesiAktif.indeksAktif = idx;
      saveStore(s);
      renderApp();
    }
  },
  selesaikanSesi() {
    const s = getStore();
    if (!s.sesiAktif || s.sesiSudahDisimpan) return navigate("#/anak/hasil");

    let benar = 0, bTot = 0, bBen = 0, uTot = 0, uBen = 0;
    s.sesiAktif.soalList.forEach(q => {
      const res = periksaJawaban(q, s.jawabanSesiAktif[q.id]);
      if (res.isBenar) benar++;
      if (q.isSpacedRepetition) {
        uTot++;
        if (res.isBenar) uBen++;
      } else {
        bTot++;
        if (res.isBenar) bBen++;
      }

      if (!s.riwayatSoal[q.id]) s.riwayatSoal[q.id] = { totalAttempt: 0, totalCorrect: 0, isScheduledSpaced: false };
      s.riwayatSoal[q.id].totalAttempt++;
      if (res.isBenar) {
        s.riwayatSoal[q.id].totalCorrect++;
        s.riwayatSoal[q.id].isScheduledSpaced = false;
      } else {
        s.riwayatSoal[q.id].isScheduledSpaced = true;
      }
    });

    s.riwayatSesi.push({
      id: "SESI-" + Date.now(),
      tanggal: new Date().toLocaleDateString("id-ID"),
      mode: s.sesiAktif.mode,
      totalSoal: s.sesiAktif.soalList.length,
      jumlahBenar: benar,
      skor: Math.round((benar / s.sesiAktif.soalList.length) * 100),
      estimasiMenit: 15,
      baruTotal: bTot, baruBenar: bBen, ulangTotal: uTot, ulangBenar: uBen
    });
    s.sesiSudahDisimpan = true;
    saveStore(s);
    navigate("#/anak/hasil");
  },
  resetData() {
    if (confirm("Reset data demo ke awal?")) {
      localStorage.removeItem("LMS_TKA_SD_STATE_V1_1");
      location.reload();
    }
  },
  openAdminModal(soal = null) {
    const modal = document.getElementById("admin-modal");
    document.getElementById("modal-error").classList.add("hidden");
    if (soal) {
      document.getElementById("modal-title").textContent = "Edit Soal (" + soal.id + ")";
      document.getElementById("edit-original-id").value = soal.id;
      document.getElementById("soal-id").value = soal.id;
      document.getElementById("soal-id").disabled = true;
      document.getElementById("soal-mapel").value = soal.mapel;
      document.getElementById("soal-kompetensi").value = soal.kompetensi;
      document.getElementById("soal-kesulitan").value = soal.kesulitan;
      document.getElementById("soal-tipe").value = soal.tipe;
      document.getElementById("soal-stimulus").value = soal.stimulus || "";
      document.getElementById("soal-tanya").value = soal.tanya;
      document.getElementById("soal-pembahasan").value = soal.pembahasan;
      window.LMS.toggleFormTipe(soal.tipe);
      if (soal.tipe === "PG") {
        document.getElementById("soal-opsi-a").value = soal.opsi[0] || "";
        document.getElementById("soal-opsi-b").value = soal.opsi[1] || "";
        document.getElementById("soal-opsi-c").value = soal.opsi[2] || "";
        document.getElementById("soal-opsi-d").value = soal.opsi[3] || "";
        document.getElementById("soal-kunci-pg").value = soal.kunci;
      } else {
        document.getElementById("soal-kunci-isian").value = soal.kunci;
        document.getElementById("soal-alt-isian").value = (soal.alternatifKunci || []).join(", ");
      }
    } else {
      document.getElementById("modal-title").textContent = "Tambah Soal Draf";
      document.getElementById("edit-original-id").value = "";
      document.getElementById("soal-id").value = "";
      document.getElementById("soal-id").disabled = false;
      document.getElementById("form-soal").reset();
      window.LMS.toggleFormTipe("PG");
    }
    modal.classList.remove("hidden");
    if (window.lucide) lucide.createIcons();
  },
  closeAdminModal() {
    document.getElementById("admin-modal").classList.add("hidden");
  },
  toggleFormTipe(t) {
    if (t === "PG") {
      document.getElementById("pg-fields").classList.remove("hidden");
      document.getElementById("isian-fields").classList.add("hidden");
    } else {
      document.getElementById("pg-fields").classList.add("hidden");
      document.getElementById("isian-fields").classList.remove("hidden");
    }
  },
  handleSaveSoal(e) {
    e.preventDefault();
    const s = getStore();
    const origId = document.getElementById("edit-original-id").value;
    const id = document.getElementById("soal-id").value.trim().toUpperCase();
    const tipe = document.getElementById("soal-tipe").value;

    if (!origId && s.bankSoal.some(x => x.id === id)) {
      alert("ID sudah digunakan!");
      return;
    }

    let opsi = [], kunci = "", alt = [];
    if (tipe === "PG") {
      opsi = [
        document.getElementById("soal-opsi-a").value.trim(),
        document.getElementById("soal-opsi-b").value.trim(),
        document.getElementById("soal-opsi-c").value.trim(),
        document.getElementById("soal-opsi-d").value.trim()
      ];
      kunci = document.getElementById("soal-kunci-pg").value;
    } else {
      kunci = document.getElementById("soal-kunci-isian").value.trim();
      alt = document.getElementById("soal-alt-isian").value.split(",").map(x => x.trim()).filter(Boolean);
    }

    const item = {
      id,
      mapel: document.getElementById("soal-mapel").value,
      kompetensi: document.getElementById("soal-kompetensi").value.trim(),
      kesulitan: document.getElementById("soal-kesulitan").value,
      tipe,
      stimulus: document.getElementById("soal-stimulus").value.trim(),
      tanya: document.getElementById("soal-tanya").value.trim(),
      opsi, kunci, alternatifKunci: alt,
      pembahasan: document.getElementById("soal-pembahasan").value.trim(),
      statusVerifikasi: "Draf AI — Perlu Verifikasi Manusia"
    };

    if (origId) {
      const idx = s.bankSoal.findIndex(x => x.id === origId);
      if (idx !== -1) s.bankSoal[idx] = item;
    } else {
      s.bankSoal.push(item);
    }

    saveStore(s);
    window.LMS.closeAdminModal();
    renderApp();
  },
  editSoal(id) {
    const s = getStore();
    const item = s.bankSoal.find(x => x.id === id);
    if (item) window.LMS.openAdminModal(item);
  },
  hapusSoal(id) {
    if (confirm("Hapus soal ini?")) {
      const s = getStore();
      s.bankSoal = s.bankSoal.filter(x => x.id !== id);
      saveStore(s);
      renderApp();
    }
  }
};

window.addEventListener("hashchange", renderApp);
window.addEventListener("DOMContentLoaded", () => {
  if (!window.location.hash) window.location.hash = "#/anak/dashboard";
  renderApp();
});
