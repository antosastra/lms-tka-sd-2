        <strong>Contoh:</strong> 8 kotak @ 24 buku = 192 buku. Terjual 45 = 147 buku. Dibagikan merata ke 3 kelas = 49 buku per kelas.
      </div>
      <button onclick="window.LMS.siapkanSesi('seimbang')" class="px-4 py-2 bg-blue-600 text-white text-xs font-bold rounded-xl">Uji Pemahaman</button>
    </div>
  `;
}

function viewHalamanLatihan(store) {
  if (!store.sesiAktif?.soalList?.length) {
    return `<div class="text-center py-12"><button onclick="window.LMS.navigate('#/anak/dashboard')" class="px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold">Pilih Sesi di Dashboard</button></div>`;
  }
  const { soalList, indeksAktif } = store.sesiAktif;
  const soal = soalList[indeksAktif];
  const ans = store.jawabanSesiAktif[soal.id] || "";

  return `
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="bg-white p-4 rounded-2xl border flex justify-between items-center text-xs">
        <span class="font-bold text-slate-700">Soal ${indeksAktif + 1} dari ${soalList.length}</span>
        <span class="px-2 py-0.5 rounded-full font-bold ${soal.isSpacedRepetition ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'}">
          ${soal.isSpacedRepetition ? 'Pengulangan Terjadwal' : 'Soal Baru'}
        </span>
      </div>

      <div class="bg-white rounded-3xl p-6 border space-y-4">
        <span class="text-xs text-slate-500 font-semibold">${soal.mapel} • ${soal.kompetensi}</span>
        ${soal.stimulus ? `<div class="p-3.5 bg-slate-50 rounded-xl text-xs text-slate-800 leading-relaxed">${soal.stimulus}</div>` : ""}
        <p class="text-sm font-bold text-slate-900">${soal.tanya}</p>

        <div class="space-y-2 pt-2">
          ${soal.tipe === "PG" ? soal.opsi.map(opt => {
            const kode = opt.trim().charAt(0);
            const isSel = (ans === kode);
            return `
              <label onclick="window.LMS.pilihJawaban('${soal.id}', '${kode}')" class="flex items-center gap-3 p-3 rounded-xl border-2 ${isSel ? 'border-blue-600 bg-blue-50/60 font-semibold' : 'border-slate-200'} cursor-pointer text-xs">
                <input type="radio" name="soal_rad" ${isSel ? 'checked' : ''}>
                <span>${escapeHtml(opt)}</span>
              </label>
            `;
          }).join('') : `
            <input type="text" value="${escapeHtml(ans)}" oninput="window.LMS.simpanIsian('${soal.id}', this.value)" placeholder="Ketik jawaban Anda..." class="w-full px-3 py-2 border rounded-xl text-xs">
          `}
        </div>

        <div class="flex justify-between pt-4 border-t">
          <button onclick="window.LMS.pindahSoal(${indeksAktif - 1})" ${indeksAktif === 0 ? 'disabled class="opacity-40 text-xs font-bold"' : 'class="text-xs font-bold text-slate-700"'}>Sebelumnya</button>
          ${indeksAktif < soalList.length - 1 ? `
            <button onclick="window.LMS.pindahSoal(${indeksAktif + 1})" class="px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold">Berikutnya</button>
          ` : `
            <button onclick="window.LMS.selesaikanSesi()" class="px-4 py-2 bg-emerald-600 text-white rounded-xl text-xs font-bold">Kirim Jawaban</button>
          `}
        </div>
      </div>
    </div>
  `;
}

function viewHasilSesi(store) {
  const latest = store.riwayatSesi[store.riwayatSesi.length - 1];
  if (!latest) return `<div class="text-center py-12"><button onclick="window.LMS.navigate('#/anak/dashboard')">Kembali</button></div>`;

  return `
    <div class="max-w-md mx-auto bg-white p-8 rounded-3xl border text-center space-y-4">
      <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full uppercase">Sesi Selesai</span>
      <h1 class="text-5xl font-black text-blue-600">${latest.skor}</h1>
      <p class="text-xs text-slate-500">${latest.jumlahBenar} dari ${latest.totalSoal} Soal Tepat</p>
      <div class="grid grid-cols-2 gap-2 text-left text-xs pt-2">
        <div class="p-3 bg-blue-50 border rounded-xl"><strong>Soal Baru</strong>: ${latest.baruBenar}/${latest.baruTotal} Benar</div>
        <div class="p-3 bg-amber-50 border rounded-xl"><strong>Pengulangan</strong>: ${latest.ulangBenar}/${latest.ulangTotal} Benar</div>
      </div>
      <div class="flex gap-2 pt-2">
        <button onclick="window.LMS.navigate('#/anak/pembahasan')" class="flex-1 py-2.5 bg-blue-600 text-white rounded-xl text-xs font-bold">Pembahasan</button>
        <button onclick="window.LMS.navigate('#/anak/dashboard')" class="flex-1 py-2.5 bg-slate-100 rounded-xl text-xs font-bold">Dashboard</button>
      </div>
    </div>
  `;
}

function viewHalamanPembahasan(store) {
  const soalList = store.sesiAktif?.soalList || store.bankSoal.slice(0, 4);
  return `
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="flex justify-between items-center">
        <h1 class="text-lg font-bold">Pembahasan Jawaban</h1>
        <button onclick="window.LMS.navigate('#/anak/dashboard')" class="text-xs font-bold text-blue-600">Selesai</button>
      </div>
      ${soalList.map((s, idx) => {
        const userAns = store.jawabanSesiAktif[s.id];
        const res = periksaJawaban(s, userAns);
        return `
          <div class="bg-white p-5 rounded-2xl border space-y-2 text-xs">
            <div class="flex justify-between font-bold">
              <span>#${idx + 1} • ${s.mapel}</span>
              <span class="${res.status === 'BENAR' ? 'text-emerald-600' : (res.status === 'KOSONG' ? 'text-slate-500' : 'text-rose-600')}">${res.status}</span>
            </div>
            <p class="text-slate-800">${s.tanya}</p>
            <div class="p-3 bg-slate-50 rounded-xl text-slate-700 space-y-1">
              <div>Jawaban Kamu: <strong>${escapeHtml(userAns || 'Tidak diisi')}</strong> | Kunci: <strong class="text-emerald-700">${s.kunci}</strong></div>
              <p class="text-slate-600 pt-1"><strong>Langkah Solusi:</strong> ${s.pembahasan}</p>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

