  return `
    <div class="max-w-2xl mx-auto bg-white p-6 rounded-2xl border space-y-2 text-xs">
      <h1 class="text-base font-bold text-slate-900">Kalender Asesmen Resmi 2027</h1>
      <p class="text-slate-600">• Asesmen Akhir Jenjang SD (ASAJ): <strong>11 – 22 Mei 2027</strong></p>
      <p class="text-slate-600">• TKA Pusat 2027: Menunggu rilis jadwal resmi pemerintah.</p>
    </div>
