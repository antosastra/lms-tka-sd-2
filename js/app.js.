function viewDashboardAnak(store) {
  const riwayat = store.riwayatSesi || [];
  let menitTotal = 0, benarTotal = 0;
  riwayat.forEach(s => {
    menitTotal += (s.estimasiMenit || 15);
    benarTotal += s.jumlahBenar;
  });
  const targetMenit = store.anak.targetMenit || 60;
  const persen = Math.min(100, Math.round((menitTotal / targetMenit) * 100));

  return `
    <div class="space-y-6">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-3xl p-6 md:p-8 shadow-lg">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold bg-white/20 px-3 py-1 rounded-full">Persiapan Ujian 2027</span>
            <h1 class="text-2xl md:text-3xl font-extrabold mt-2">Halo, ${escapeHtml(store.anak.nama)}! 👋</h1>
            <p class="text-blue-100 text-sm mt-1">Latihan bertahap untuk membangun pemahaman konsep.</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="bg-white/10 backdrop-blur border border-white/20 px-4 py-3 rounded-2xl text-center">
              <div class="text-amber-300 font-extrabold text-lg flex items-center justify-center gap-1"><i data-lucide="check-circle" class="w-5 h-5"></i> ${riwayat.length}</div>
              <span class="text-[11px] text-blue-100">Sesi Selesai</span>
            </div>
            <div class="bg-white/10 backdrop-blur border border-white/20 px-4 py-3 rounded-2xl text-center">
              <div class="text-emerald-300 font-extrabold text-lg flex items-center justify-center gap-1"><i data-lucide="award" class="w-5 h-5"></i> ${benarTotal}</div>
              <span class="text-[11px] text-blue-100">Jawaban Tepat</span>
            </div>
          </div>
        </div>
        <div class="mt-6 bg-white/10 rounded-2xl p-4 border border-white/15">
          <div class="flex justify-between text-xs mb-2 font-medium">
            <span>Target Waktu: <strong>${menitTotal} dari ${targetMenit} Menit</strong></span>
            <span>${persen}%</span>
          </div>
          <div class="w-full bg-black/20 rounded-full h-3 overflow-hidden">
            <div class="bg-amber-400 h-3 rounded-full" style="width: ${persen}%"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 space-y-4">
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-slate-900">Mulai Latihan Hari Ini</h2>
              <button onclick="window.LMS.navigate('#/anak/rencana')" class="text-xs font-semibold text-blue-600 hover:underline">Rencana Lengkap</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/50 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] uppercase font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded">Rekomendasi</span>
                  <h3 class="font-bold text-sm text-slate-900 mt-2">Sesi Seimbang</h3>
                  <p class="text-xs text-slate-500 mt-1">4 Soal • 2 Matematika & 2 B. Indonesia</p>
                </div>
                <button onclick="window.LMS.siapkanSesi('seimbang')" class="mt-4 w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-sm">Mulai Campuran</button>
              </div>
              <div class="p-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded">Fokus</span>
                  <h3 class="font-bold text-sm text-slate-900 mt-2">Matematika</h3>
                  <p class="text-xs text-slate-500 mt-1">4 Soal • Bilangan & Geometri</p>
                </div>
                <button onclick="window.LMS.siapkanSesi('matematika')" class="mt-4 w-full py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-xl">Mulai Matematika</button>
              </div>
              <div class="p-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] uppercase font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded">Fokus</span>
                  <h3 class="font-bold text-sm text-slate-900 mt-2">B. Indonesia</h3>
                  <p class="text-xs text-slate-500 mt-1">4 Soal • Teks Informasi & Sastra</p>
                </div>
                <button onclick="window.LMS.siapkanSesi('indonesia')" class="mt-4 w-full py-2 bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs rounded-xl">Mulai B. Indonesia</button>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
            <h2 class="text-base font-bold text-slate-900">Riwayat Latihan Terkini</h2>
            ${riwayat.length === 0 ? `
              <div class="text-center py-6 border-2 border-dashed rounded-2xl text-xs text-slate-500">Belum ada sesi latihan yang diselesaikan. Pilih salah satu sesi di atas untuk mencoba.</div>
            ` : `
              <div class="divide-y">
                ${riwayat.slice(-3).reverse().map((s, i) => `
                  <div class="py-2.5 flex justify-between items-center text-xs">
                    <div>
                      <strong class="text-slate-800">Sesi #${riwayat.length - i} (${escapeHtml(s.mode)})</strong>
                      <div class="text-slate-500">${s.tanggal} • ${s.jumlahBenar} dari ${s.totalSoal} Soal Benar</div>
                    </div>
                    <div class="text-right">
                      <span class="text-base font-black text-blue-600 block">${s.skor}</span>
                      <span class="text-[10px] text-slate-400">Skor</span>
                    </div>
                  </div>
                `).join('')}
              </div>
            `}
          </div>
        </div>

        <div class="space-y-4">
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm space-y-2">
            <h3 class="text-sm font-bold text-indigo-700 flex items-center gap-1.5"><i data-lucide="repeat" class="w-4 h-4"></i> Spaced Repetition</h3>
            <p class="text-xs text-slate-600">Soal yang dijawab kurang tepat akan otomatis diprioritaskan untuk diulang pada sesi berikutnya.</p>
          </div>
        </div>
      </div>
    </div>
  `;
}

