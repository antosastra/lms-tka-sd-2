function viewMateriPembelajaran() {
  return `
    <div class="max-w-2xl mx-auto bg-white p-6 rounded-3xl border space-y-4">
      <button onclick="window.LMS.navigate('#/anak/dashboard')" class="text-xs font-bold text-slate-600">← Kembali</button>
